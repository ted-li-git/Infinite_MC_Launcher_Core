        "prepublishOnly": "npm run build",
        "prepare": "npm run build"
    },
    "keywords": [
        "minecraft",
        "launcher",
        "infinite",
        "authentication",
        "offline",
        "microsoft",
        "mojang",
        "forge",
        "neoforge"
    ],
    "author": "LJT",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ted-li-git/Infinite_MC_Launcher_Core.git"
    },
    "bugs": {
        "url": "https://github.com/ted-li-git/Infinite_MC_Launcher_Core/issues"
    },
    "homepage": "https://github.com/ted-li-git/Infinite_MC_Launcher_Core#readme",
    "devDependencies": {
        "@rollup/plugin-node-resolve": "^15.0.0",
        "@rollup/plugin-commonjs": "^25.0.0",
        "rollup": "^3.0.0",
        "@rollup/plugin-terser": "^0.4.4",
        "eslint": "^8.0.0",
        "jest": "^29.0.0"
    },
    "dependencies": {
        "node-fetch": "^3.0.0",
        "uuid": "^9.0.0"
