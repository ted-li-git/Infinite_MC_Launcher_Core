{
    "name": "@ted-li-git/infinite-mc-launcher-core",
    "version": "1.0.3-beta.1",
    "description": "Infinite MC Launcher Core - 跨平台Minecraft启动器核心库，支持1.12.2-最新版本原版与Forge/NeoForge",
    "main": "dist/mc-launcher.js",
